# Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (e.g. Supabase, Neon, Render, or Local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobconnect_db?schema=public"

# JWT Secret Key for token signing
JWT_SECRET="your_super_secret_jwt_key_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# Allowed Frontend Origins (CORS)
FRONTEND_URL="http://localhost:3000"
